 /* Le masque est calculé avant écriture, sur les valeurs originales, contre tout
  * historique retenu recoupant la période. Un ratio ou une distribution ne doit
  * pas servir de substitut à un effectif masqué. */
+/* V3.6 : compléments déductibles des compteurs publiés. Uniquement les
+ * relations d'inclusion garanties par itpAtzCalculer, pas des corrélations.
+ * Ne jamais traiter une valeur masquée comme zéro. */
+function itpAtzComplementsPublies(array $cell): array {
+    $relations = [
+        'participants' => ['court_termines', 'long_ouverts', 'long_termines', 'long_apres_court', 'quiz_repondus', 'quiz_corrects', 'notes_k_donnees'],
+        'court_termines' => ['long_apres_court'],
+        'long_ouverts' => ['long_termines', 'long_apres_court'],
+        'quiz_repondus' => ['quiz_corrects'],
+    ];
+    $resultat = [];
+    foreach ($relations as $total => $sousEnsembles) foreach ($sousEnsembles as $sousEnsemble) {
+        $a = $cell[$total] ?? null; $b = $cell[$sousEnsemble] ?? null;
+        if (is_int($a) && is_int($b) && $a >= $b && $b >= 0) $resultat[$total . '/' . $sousEnsemble] = $a - $b;
+    }
+    return $resultat;
+}
+function itpAtzComplementFragile(array $valeurs, array $precedent, int $seuil): bool {
+    $avant = itpAtzComplementsPublies($precedent);
+    foreach (itpAtzComplementsPublies($valeurs) as $nom => $v) {
+        if ($v > 0 && $v < $seuil) return true;
+        $p = $avant[$nom] ?? null;
+        if ($p !== null && $v !== $p && abs($v - $p) < $seuil) return true;
+    }
+    return false;
+}
